{
	"name": "ts-migrating",
	"version": "2.0.0-beta.0",
	"description": "Progressively Upgrade `tsconfigs.json`",
	"author": "Jason Yu <me@ycmjason.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/ycmjason/ts-migrating.git"
	},
	"homepage": "https://github.com/ycmjason/ts-migrating#readme",
	"bugs": {
		"url": "https://github.com/ycmjason/ts-migrating/issues"
	},
	"keywords": [
		"typescript",
		"migration",
		"cli",
		"tsconfig"
	],
	"bin": "./dist/cli/main.js",
	"exports": {
		"./cli": "./dist/cli/main.js",
		"./api": {
			"types": "./dist/api/mod.d.ts",
			"default": "./dist/api/mod.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"biome.config.json"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"build:watch": "tsc -p tsconfig.build.json --watch",
		"check": "pnpm check:lint && pnpm check:type && pnpm test",
		"check:lint": "biome check .",
		"check:lint:fix": "pnpm check:lint --write",
		"check:type": "tsc",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@types/node": "^22.20.5",
		"typescript": "7.1.0-beta",
		"vitest": "^5.0.5"
	},
	"peerDependencies": {
		"typescript": ">=7.1.0-0 <8"
	},
	"engines": {
		"node": ">=22.18.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24"
		}
	},
	"dependencies": {
		"@babel/parser": "^8.0.10",
		"@stricli/core": "^1.3.0",
		"recast": "^0.24.0"
	},
	"packageManager": "pnpm@12.16.1",
	"type": "module"
}
